[resource]
script = ExtResource("1_card")
id = "breathe_it_in"
display_name = "Breathe It In"
description = "Statuses added to nightmares in a {family:sporeling} Warden's range get 1 more {stack}, 3 if it is {asleep} or {held}. Once a second per Warden."
tip = "Any family's statuses count, {spored} too. {drowsy} gets only 1 more. Doesn't add {held}; never past {full}. Only stacks a Warden's own attack adds count, not stacks added by other cards or your Calling. Works for: every Warden whose targets walk through a {family:sporeling} Warden's range. Safe."
rarity = 0
kind = 3
tags = Array[String](["spore", "lent"])
max_stacks = 1
rule_id = &"breathe_it_in"
requires = Array[String](["sporeling"])
makes = Array[StringName]([&"stacks"])
