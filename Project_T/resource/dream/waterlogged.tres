[gd_resource type="Resource" script_class="UpgradeData" load_steps=2 format=3]

[ext_resource type="Script" path="res://resource/dream/script/upgrade_data.gd" id="1_card"]

[resource]
script = ExtResource("1_card")
id = "waterlogged"
display_name = "Waterlogged"
description = "Needs another {family}'s status. On a {damp} nightmare, other families' statuses from Wardens {near} a {warden:dewdrop} last half again as long."
tip = "Set when the status lands: the Warden near a {warden:dewdrop}, the nightmare {damp} at that moment. Never {drowsy}, {damp} or Rooted. A bet: it does little until a Warden of another family that adds a status stands near a {warden:dewdrop}."
rarity = 2
kind = 3
tags = Array[String](["water", "lent"])
max_stacks = 1
rule_id = &"waterlogged"
requires = Array[String](["dewdrop"])
