[resource]
script = ExtResource("1_card")
id = "waterlogged"
display_name = "Slow to Dry"
description = "Needs another {family}'s status. On a {damp} nightmare {near} a {warden:dewdrop}, other families' statuses can't run out before its {damp} does."
tip = "They linger to match, up to 4 s past their last landing (Charged 2 s). Never Rooted or {drowsy}. A bet: it needs a {warden:dewdrop} Soaking the nightmares another family's statuses are on."
