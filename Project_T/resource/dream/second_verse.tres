[resource]
script = ExtResource("1_card")
id = "second_verse"
display_name = "Second Verse"
description = "When a nightmare leaves a {family:bellflower} Warden's range, the last status another Warden gave it lands again."
tip = "Another Warden: any but that {family:bellflower} Warden; other {family:bellflower} Wardens count. Same {stacks} as before. Doesn't add {held} or {frost}. It never starts a status or goes past {full}; {static} stops 1 short of a bolt. Once for each {family:bellflower} Warden and nightmare. Works for: status Wardens before a {family:bellflower} Warden. A bet: needs a second status Warden."
rarity = 1
kind = 3
tags = Array[String](["song", "lent"])
