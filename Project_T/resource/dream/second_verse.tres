[resource]
script = ExtResource("1_card")
id = "second_verse"
display_name = "Second Verse"
description = "Needs another {family}'s status. A nightmare a bell hit, leaving that bell's range, gets the last status another {family}'s Warden gave it again, same {stacks}."
tip = "Once for each nightmare and bell. Never starts a status, never past its most; {static} stops one short of a bolt. Works for: status Wardens of any family placed before a bell. A bet."
