[resource]
script = ExtResource("1_card")
id = "second_verse"
display_name = "Second Verse"
description = "When a nightmare leaves a bell's range, the last status another Warden gave it lands again."
tip = "Another Warden: any but that bell; other bells count. Same {stacks} as before. Doesn't add {held}. It never starts a status or goes past {full}; {static} stops 1 short of a bolt. Once for each bell and nightmare. Works for: status Wardens before a bell. A bet: needs a second status Warden."
