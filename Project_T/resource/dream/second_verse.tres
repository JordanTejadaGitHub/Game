[ext_resource type="Script" path="res://resource/dream/script/upgrade_data.gd" id="1_card"]

[resource]
script = ExtResource("1_card")
id = "second_verse"
display_name = "Second Verse"
description = "Needs another {family}'s status. When a nightmare a bell has hit leaves that bell's range, the last status another {family} gave it lands again."
tip = "Same {stacks} as before. {drowsy} and {held} don't count. It never starts a status. Once for each bell and nightmare. Never past {full}; {static} stops 1 short of a bolt. Works for: status Wardens placed before a bell. A bet: needs another family's statuses."
rarity = 1
kind = 3
tags = Array[String](["song", "lent"])
max_stacks = 1
rule_id = &"second_verse"
requires = Array[String](["bellflower"])
makes = Array[StringName]([&"stacks"])
