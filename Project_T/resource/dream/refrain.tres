script = ExtResource("1_card")
id = "refrain"
display_name = "Refrain"
description = "Needs another {family}'s Warden. A Tolled nightmare rings on for 2 s: the next hit on it from that Warden lands again, in full."
tip = "A ring is a hit from a bell. Every 4th ring on a nightmare is a Toll: it lands again at half damage (on a Bellflower start the first Toll is ring 2). Works for: another {family}'s Warden, anywhere. A bet: it does little until you own another {family}."
