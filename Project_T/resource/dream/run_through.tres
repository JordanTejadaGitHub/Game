display_name = "Run Through"
description = "A {final_form} or {ascended} Warden's direct hit carries on to the next 2 nightmares behind its target, each taking half."
tip = "Only nightmares within 2 cells along the path; flyers don't count. The carried hits are damage only: no statuses, no other cards."
