[resource]
script = ExtResource("1_card")
id = "ebb"
display_name = "Ebb"
description = "When a status runs out on a nightmare in a {family:dewdrop} Warden's range, it comes back with half its highest {stacks} for 3 s."
tip = "Only a status that ran out of time comes back; one a {reaction} spent never does. Once for each status and nightmare. Doesn't bring back {held}, {drowsy} or {frost}; {static} stops 1 short of a bolt. Works for: every family's statuses. Safe."
rarity = 1
kind = 3
tags = Array[String](["water", "lent"])
max_stacks = 1
rule_id = &"ebb"
requires = Array[String](["dewdrop"])
makes = Array[StringName]([&"linger"])
