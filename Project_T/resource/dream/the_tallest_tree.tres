[ext_resource type="Script" path="res://resource/dream/script/upgrade_data.gd" id="1_card"]

[resource]
script = ExtResource("1_card")
id = "the_tallest_tree"
display_name = "The Tallest Tree"
description = "Choose a Warden as your Tallest Tree. Wardens {touching} it stop attacking, and each one gives the Tree an extra attack whenever it attacks."
tip = "Sprouts and walls don't count; at most 8 Wardens. Only a Warden that attacks can be the Tallest Tree. Of each volley's extra attacks, only 2 trigger on-hit cards. Choose it on its panel: the first time whenever you like, then at a {rest}."
rarity = 3
kind = 3
tags = Array[String](["tall", "hits", "defining"])
max_stacks = 1
min_act = 2
rule_id = &"the_tallest_tree"
