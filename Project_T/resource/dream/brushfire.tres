script = ExtResource("1_card")
id = "brushfire"
display_name = "Brushfire"
description = "Needs a Warden that deals damage over time. When a Firefly Warden has hit a nightmare in the last 2 s, half of its status damage {jumps} to the nearest other nightmare."
tip = "Status damage: {spored} ticks, clouds and fog, not bolts or {reactions}. Nearest: within 2 cells. Once a second for each nightmare. At most 3 s of that Firefly Warden's damage. Works for: {spored} and cloud Wardens beside a Firefly Warden. A bet: needs both."
