[resource]
script = ExtResource("1_card")
id = "overnight"
display_name = "Overnight"
description = "Needs another {family}'s status. A {family:sporeling} Warden's hit adds 2 {stacks} to each status other {families} put on the nightmare."
tip = "It never starts a status. Each nightmare once a second. Doesn't add {held} or {frost}; never past {full}; {static} stops 1 short of a bolt. Works for: {family:sporeling} Wardens behind other families' status Wardens. A bet: needs both."
