[resource]
script = ExtResource("1_card")
id = "sitting_ducks"
display_name = "Sitting Ducks"
description = "Needs a sleeping or held nightmare. Status hits on one {near} a spore Warden add 2 more {stacks}. Once a second per Warden. Doesn't add {drowsy}."
tip = "Held or asleep: Rootling Holds, Nod Off, Dreamshroom. {static} and {marked} gain 1 more, not 2. A bet: it does little until a Warden of yours holds nightmares or puts them to sleep."
