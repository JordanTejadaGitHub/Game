script = ExtResource("1_card")
id = "sparks_fly"
display_name = "Sparks Fly"
description = "For 2 s after a Firefly Warden hits a nightmare, every 3rd hit another Warden lands on it {jumps} half to the nearest other nightmare. Sprouts count."
tip = "Counted for each Warden on each nightmare; an area attack counts once. Any Firefly form's hit starts the 2 s; Firefly Wardens' own hits are not counted. Works for: quick Wardens of any family beside your Firefly Wardens. Safe."
