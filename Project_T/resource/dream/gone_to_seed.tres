[ext_resource type="Script" path="res://resource/dream/script/upgrade_data.gd" id="1_card"]

[resource]
script = ExtResource("1_card")
id = "gone_to_seed"
display_name = "Gone to Seed"
description = "When a hit fills a status on a nightmare {near} a spore Warden, every other status on it gains 5 {stacks}."
tip = "Fills: brings it to {full}. Any family's statuses count, {spored} too. Each nightmare once every 2 s. Never {held}, never past {full}; {static} stops 1 short of a bolt. A bet: needs a second status on the nightmare."
rarity = 2
kind = 3
tags = Array[String](["spore", "lent"])
max_stacks = 1
rule_id = &"gone_to_seed"
requires = Array[String](["sporeling"])
uses = Array[StringName]([&"stacks"])
