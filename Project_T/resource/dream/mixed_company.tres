[ext_resource type="Script" path="res://resource/dream/script/upgrade_data.gd" id="1_card"]

[resource]
script = ExtResource("1_card")
id = "mixed_company"
display_name = "Mixed Company"
description = "Hits on a nightmare {near} a spore Warden add double {stacks} while it carries 3 or more statuses. Each Warden once a second."
tip = "Any 3 statuses from any Wardens count; {held} never counts or doubles. Only the hit's own {stacks} double. Never past {full}; {static} stops 1 short of a bolt. A bet: needs 3 statuses on the same nightmares."
rarity = 2
kind = 3
tags = Array[String](["spore", "lent"])
max_stacks = 1
rule_id = &"mixed_company"
requires = Array[String](["sporeling"])
