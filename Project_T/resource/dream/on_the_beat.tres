[resource]
script = ExtResource("1_card")
id = "on_the_beat"
display_name = "On the Beat"
description = "When a bell attacks, Wardens {touching} it that are at least half reloaded attack at once. Each Warden, once every 2 s."
tip = "Not other bells. A Warden that only just attacked waits as usual, so slow Wardens are never doubled. Works for: any Warden beside a bell. Safe."
rarity = 0
kind = 3
tags = Array[String](["song", "lent"])
max_stacks = 1
rule_id = &"on_the_beat"
requires = Array[String](["bellflower"])
