id = "sound_carries"
display_name = "Sound Carries"
description = "A pulsing bell's ring carries 4 steps down the path past its range, at half damage, stopping at the next bell's range. Carried rings count."
tip = "A ring is a hit from a bell. Every 4th ring on a nightmare is a Toll: it lands again at half damage (on a Bellflower start the first Toll is ring 2). Works for: a pulsing bell. Safe: it works with this {family}, Sprouts and Thornwalls alone."
