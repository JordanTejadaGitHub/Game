[resource]
script = ExtResource("1_card")
id = "seeping_in"
display_name = "Settling Spores"
description = "While a nightmare walks inside a spore Warden's range, each status it has gains 3 {stacks} every 6 {steps}."
tip = "Never starts a new status. {held} doesn't count. Steps it is pulled or pushed back over don't count again. Works for: every family's statuses. Safe."
