[gd_resource type="Resource" script_class="UpgradeData" load_steps=2 format=3]

[ext_resource type="Script" path="res://resource/dream/script/upgrade_data.gd" id="1_card"]

[resource]
script = ExtResource("1_card")
id = "the_water_remembers"
display_name = "The Tide Remembers"
description = "Needs another {family}'s status. A nightmare walking back into a {warden:dewdrop}'s range gets back other families' statuses that wore off since it left."
tip = "Walking back: it comes back in at least 3 {steps} further along the path than where it left (a pull back doesn't count). Once for each nightmare and {warden:dewdrop}. A bet: your path must pass the same {warden:dewdrop} twice."
rarity = 1
kind = 3
tags = Array[String](["water", "lent"])
max_stacks = 1
rule_id = &"the_water_remembers"
requires = Array[String](["dewdrop"])
