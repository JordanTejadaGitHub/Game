[gd_resource type="Resource" script_class="UpgradeData" load_steps=2 format=3]

[ext_resource type="Script" path="res://resource/dream/script/upgrade_data.gd" id="1_card"]

[resource]
script = ExtResource("1_card")
id = "the_water_remembers"
display_name = "The Tide Remembers"
description = "Needs another {family}'s status. When a nightmare comes back into a {warden:dewdrop}'s range, statuses from other families that ran out since it left come back."
tip = "Comes back: re-enters 3 or more {steps} further along the path; a pull back doesn't count. Statuses return as they were when it left, for 3 s. Once for each {warden:dewdrop} and nightmare. A bet: your path must pass the same {warden:dewdrop} twice."
rarity = 1
kind = 3
tags = Array[String](["water", "lent"])
max_stacks = 1
rule_id = &"the_water_remembers"
requires = Array[String](["dewdrop"])
