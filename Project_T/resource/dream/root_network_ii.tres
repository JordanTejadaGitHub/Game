[resource]
script = ExtResource("1_card")
id = "root_network_ii"
display_name = "Root Network II"
description = "Each Sprout deals 6% more damage for each Sprout in its network, up to +60%. Diagonals join networks too."
rarity = 2
kind = 3
tags = Array[String](["sprout", "wide", "overgrowth"])
