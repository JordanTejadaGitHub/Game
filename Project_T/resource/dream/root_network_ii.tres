diagram = ".......\n.......\n.WWW...\n....W..\n......."
diagram_caption = "Sprouts touching, diagonals too: +6% per Sprout in the network, +24% here."
tip = "Network: Sprouts joined side by side or corner to corner, itself included. A Sprout on its own gets nothing."
