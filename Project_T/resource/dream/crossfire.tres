[ext_resource type="Script" path="res://resource/dream/script/upgrade_data.gd" id="1_card"]

[resource]
script = ExtResource("1_card")
id = "crossfire"
display_name = "Crossfire"
description = "When a Firefly Warden and another {family}'s Warden {near} it hit the same nightmare within 1 s, half the hit {jumps} to the 2 nightmares just behind it."
rarity = 1
kind = 3
tags = Array[String](["storm", "lent"])
max_stacks = 1
rule_id = &"lent_crossfire"
requires = Array[String](["firefly_jar"])
tip = "Behind: the nearest nightmares that are no further along the path. Half of the smaller hit. Each nightmare once every 3 s. At most 3 s of the Firefly Warden's damage. Works for: another family's Warden near a Firefly Warden. A bet: both must hit one nightmare."
