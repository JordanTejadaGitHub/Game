script = ExtResource("1_card")
id = "caught_wading"
display_name = "Caught Wading"
description = "When a {warden:dewdrop} first Soaks a nightmare, up to 3 other Wardens {near} that {warden:dewdrop} hit it once, free; again when it is fully {damp}."
tip = "A free hit is one hit outside the Warden's normal attacks, at most once a second each, never harder than the {warden:dewdrop}'s own hit. Forms that make no {damp} (Frostfern, Jetreed, Torrent, Maelstrom, Undercurrent) don't triggered it. Works for: any Warden near a {warden:dewdrop}. Safe."
