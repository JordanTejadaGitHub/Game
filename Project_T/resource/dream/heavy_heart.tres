[ext_resource type="Script" path="res://resource/dream/script/upgrade_data.gd" id="1_card"]

[resource]
script = ExtResource("1_card")
id = "heavy_heart"
display_name = "Heavy Heart"
description = "When a {heavy} Warden's hit sets off a {reaction}, the same {reaction} also goes off on the 2 nearest nightmares."
tip = "Nearest: within 3 cells and carrying one of that {reaction}'s statuses. Each copy uses up statuses and waits as usual, and never copies again. Works for: {heavy} Wardens like {warden:jetreed}, {warden:frostfern} and {warden:silver_bell}."
rarity = 2
kind = 3
tags = Array[String](["role", "heavy", "reaction"])
max_stacks = 1
min_act = 2
rule_id = &"heavy_heart"
requires_role = &"heavy"
min_owned_statuses = 2
