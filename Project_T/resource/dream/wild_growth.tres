[gd_resource type="Resource" script_class="UpgradeData" load_steps=2 format=3]

[ext_resource type="Script" path="res://resource/dream/script/upgrade_data.gd" id="1_card"]

[resource]
script = ExtResource("1_card")
id = "wild_growth"
display_name = "Wild Growth"
description = "Wardens {grow} into their next form for free after 20, 60, then 150 {dispels} in their range. They can't {grow} for {dew}."
tip = "A dispel counts for the Warden that lands it and the 2 nearest other Wardens with it in range. You pick the form; branches still need Dreamlight, and Nurture {rank}s still pay their difference. Not Thornwalls, the Sapling or Ascended forms. Can't be taken with {card:clean_night}. Works for: Sprouts and every family's Wardens. A bet: where nightmares die."
rarity = 3
kind = 3
tags = Array[String](["growth"])
max_stacks = 1
min_act = 2
in_start_pool = true
rule_id = &"wild_growth"
excludes = Array[String](["clean_night"])
