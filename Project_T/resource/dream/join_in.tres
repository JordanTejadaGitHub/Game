[ext_resource type="Script" path="res://resource/dream/script/upgrade_data.gd" id="1_card"]

[resource]
script = ExtResource("1_card")
id = "join_in"
display_name = "Join In"
description = "Hits from other Wardens touching a bell count as its rings (Sprouts count); another {family}'s Wardens near a bell count too. Each Warden, once a second."
tip = "A ring is a hit from a bell. Every 4th ring on a nightmare is a Toll: it lands again at half damage (on a Bellflower start the first Toll is ring 2). Works for: any other Warden touching a bell. Safe: it works with this {family}, Sprouts and Thornwalls alone."
rarity = 0
kind = 3
tags = Array[String](["song", "lent"])
max_stacks = 1
rule_id = &"join_in"
requires = Array[String](["bellflower"])
extra_rules = Array[StringName]([&"struck_bell"])
