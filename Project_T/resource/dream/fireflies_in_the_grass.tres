[ext_resource type="Script" path="res://resource/dream/script/upgrade_data.gd" id="1_card"]

[resource]
script = ExtResource("1_card")
id = "fireflies_in_the_grass"
display_name = "Fireflies in the Grass"
description = "For each Firefly Warden you own, one Sprout of your choice glows: a small light of its own."
rarity = 0
kind = 3
tags = Array[String](["storm", "sprout"])
max_stacks = 1
rule_id = &"lit_sprouts"
calling = "firefly_jar"
tip = "Choose on the Sprout's panel, at a rest. A glowing Sprout lights the path touching it, as bright as a base Firefly Jar. Never gold path. Not inside a Firefly Warden's glow. Works for: Sprouts, on a Lanternway board. Safe."
