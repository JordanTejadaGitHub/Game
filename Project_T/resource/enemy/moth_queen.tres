[resource]
script = ExtResource("1_edata")
sprite_frames = ExtResource("2_frames")
display_name = "The Moth Queen"
health = 16000
speed = 65.0
dew_reward = 80
leaf_cost = 5
is_boss = true
resists = Array[String](["spore", "wing"])
weak_to = Array[String](["light"])
trait_kind = 1
brood = ExtResource("3_brood")
brood_interval = 4.0
eclipse_time = 5.0
trait_text = "Flies along the route above the maze, dropping Lurkers. At half health, the Eclipse."
cleanse_line = "Her wings burn white and come apart into a thousand small moths, flying off every way at once."
title = "the wings that close the sky"
flying_icon = &"flying"
abilities = Array[Dictionary]([{"name": "Flight", "icon": &"flying", "text": "Flies along the route: walls can't stop her.", "when": "from the start"}, {"name": "Brood", "icon": &"hidden", "text": "Drops a {brood:name} onto the nearest path; it walks the maze from there.", "when": "every {brood_interval} s"}, {"name": "Eclipse", "icon": &"eclipse", "text": "Her wings close over the dream: for {eclipse_time} s every other nightmare is hidden unless something reveals it.", "when": "at 50% health"}])
tips = Array[String](["She follows your maze from above: the longer it winds, the longer your Wardens have her.", "Something that reveals the hidden keeps the field in sight through the Eclipse."])
whisper = "The light is going out. There are wings everywhere."
flies_along_route = true
status_immune = Array[StringName]([&"held"])
