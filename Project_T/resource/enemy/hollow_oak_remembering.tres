rises_from_blight = 10
trait_text = "Remembering: echoes of the great nightmares you dispelled rise from its bark."
cleanse_line = "The Hollow Oak is still. Somewhere beyond the dream, the Hollow remembers."
title = "the grief that can't let go"
abilities = Array[Dictionary]([{"name": "Echoes", "icon": &"rises", "text": "An echo of a great nightmare you dispelled this run rises beside it, with {echo_share:pct} of that nightmare's health and all of its tricks.", "when": "at {echo_at:list_pct} health"}, {"name": "The Hollow Oak Remembers", "icon": &"rises", "text": "The first time it's dispelled, it rises again at half health.", "when": "at Blight Level {rises_from_blight} and above"}])
tips = Array[String](["Remember how you beat them the first time.", "Every echo walks your whole maze again.", "The faces fade in the light."])
whisper = "It's here. It remembers every one of them."
