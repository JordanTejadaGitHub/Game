[resource]
script = ExtResource("1_edata")
sprite_frames = ExtResource("2_frames")
kind = 5
display_name = "The Hollow Oak"
health = 26000
speed = 35.0
dew_reward = 100
leaf_cost = 5
is_boss = true
stays_at_heartwood = true
echo_at = Array[float]([0.75, 0.5, 0.25])
echo_share = 0.2
rises_from_blight = 10
trait_text = "Remembering: echoes of the bosses you dispelled this run rise from its bark."
cleanse_line = "It's still. Far off, something sighs."
title = "the Hollow's heart, wearing faces"
abilities = Array[Dictionary]([{"name": "Echoes", "icon": &"rises", "text": "An echo of a boss you dispelled this run rises beside it. It has {echo_share:pct} of that boss's health and all of its tricks.", "when": "at {echo_at:list_pct} health"}, {"name": "The Hollow Oak Remembers", "icon": &"rises", "text": "The first time it's dispelled, it rises again at half health.", "when": "at Blight Level {rises_from_blight} and above"}])
tips = Array[String](["Be ready for every boss you dispelled this run: each echo has all of that boss's tricks.", "Every echo walks your whole maze again.", "Remember how you beat them the first time."])
whisper = "It's here. It remembers every one of them."
