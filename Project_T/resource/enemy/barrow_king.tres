trait_text = "Wears a {dread_shell}, clears statuses from himself and the nightmares near him, and can't gain {held}: rely on heavy hits."
cleanse_line = "The Barrow King lies down again, and this time he sleeps."
title = "the king under the hill"
abilities = Array[Dictionary]([{"name": "Barrow Plate", "icon": &"dread_shell", "text": "A {dread_shell} takes {coat_per_hit} off every hit until it has absorbed {coat_total}. Shrugging never mends it.", "when": "until it breaks"}, {"name": "Iron Will", "icon": &"rises", "text": "Slows never take him below {min_speed_share:pct} of his speed, and he can't gain {held}.", "when": "always"}, {"name": "Shrug", "icon": &"grief", "text": "Clears every status from himself and every nightmare within {shrug_radius} cells. {static} fades without a bolt.", "when": "every {shrug_interval} s"}, {"name": "Crown of the Dead", "icon": &"grief", "text": "{grief_count} {grief_spawn:name}s rise around him.", "when": "at {grief_at:list_pct} health"}])
tips = Array[String](["Hit hard between his shrugs: statuses won't last on him.", "Dispel him fast, before the dead rise.", "Pulls drag him back toward his barrow."])
whisper = "The hill has opened. The old king walks."
