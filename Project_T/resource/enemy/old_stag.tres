abilities = Array[Dictionary]([{"name": "Trample", "icon": &"trample", "text": "Knocks down a Thornwall beside it for good, up to {trample_max} each trip. The path always stays open.", "when": "every {trample_interval} s"}, {"name": "Charge", "icon": &"charge", "text": "Its antlers flare and it charges at {straight_charge_multiplier}× speed to the end of the straight, still trampling.", "when": "on every straight of {straight_charge_tiles}+ tiles"}, {"name": "Bellow", "icon": &"grief", "text": "It bellows, and {bellow_count} {bellow_spawn:name}s run in from the forest's edge.", "when": "at 50% health"}])
tips = Array[String](["It tramples walls in its path: don't let the whole maze hang on one wall.", "Break up long straights with turns: it charges down every straight of 4 tiles or more.", "Rain douses the ghost-fire in its antlers."])
