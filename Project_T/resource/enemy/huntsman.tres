abilities = Array[Dictionary]([{"name": "The Pack", "icon": &"hidden", "text": "{follower_count} {followers:name}s run with him. While one is within {pack_shield_reach} cells of him, he takes {pack_shield:pct} damage.", "when": "always"}, {"name": "The Horn", "icon": &"grief", "text": "Calls a new {brood:name} while the pack is short.", "when": "every {brood_interval} s"}, {"name": "The Kill", "icon": &"charge", "text": "He blows the horn three times and the whole pack returns at once. After that the horn is silent.", "when": "at 50% health"}])
tips = Array[String](["Dispel his hounds first: he takes half damage while one is near.", "His {nightmare:hedgehog}s sprint down straight paths: give them corners.", "At half health the whole pack comes back at once: save something for it."])
