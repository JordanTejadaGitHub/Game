abilities = Array[Dictionary]([{"name": "The Pack", "icon": &"hidden", "text": "{follower_count} {followers:name}s run with him. While any of them hunts, he takes {pack_shield:pct} damage.", "when": "always"}, {"name": "The Horn", "icon": &"grief", "text": "Calls a new {brood:name} while the pack is short.", "when": "every {brood_interval} s"}, {"name": "The Kill", "icon": &"charge", "text": "Blows three times: the whole pack returns at once, then the horn falls silent.", "when": "at 50% health"}])
tips = Array[String](["Break the pack first, then the rider.", "The hounds sprint down straight corridors: give them corners.", "A thrown stone breaks the horn."])
