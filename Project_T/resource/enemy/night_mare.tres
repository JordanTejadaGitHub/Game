abilities = Array[Dictionary]([{"name": "Laps", "icon": &"charge", "text": "At the Heartwood it can't be hit or given statuses: it stays {lap_linger} s, {lap_linger_step} s longer each lap, draining a leaf every 2 s, then gallops back to the start {lap_speed_multiplier:plus_pct} faster with {lap_spawn_count} {lap_spawn:name}s behind it, again and again.", "when": "each time it gets through"}, {"name": "Bolt", "icon": &"charge", "text": "It bolts {charge_speed_multiplier:plus_pct} faster for {charge_time} s.", "when": "at 50% health"}])
tips = Array[String](["It can only be hurt on the path, never at the Heartwood: every lap is another pass through your whole maze, so make it long.", "It keeps the damage it's taken, so each lap brings it closer to the end.", "Lantern light spooks it."])
whisper = "Hoofbeats. Something is running through the dream."
