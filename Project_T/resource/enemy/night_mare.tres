abilities = Array[Dictionary]([{"name": "Laps", "icon": &"charge", "text": "It can't be hurt or given statuses at the Heartwood. It stays {lap_linger} s ({lap_linger_step} s longer each lap), draining a leaf every 2 s. Then it runs the maze again from the start, {lap_speed_multiplier:plus_pct} faster, with {lap_spawn_count} {lap_spawn:name}s behind it.", "when": "each time it reaches the Heartwood"}, {"name": "Bolt", "icon": &"charge", "text": "It bolts {charge_speed_multiplier:plus_pct} faster for {charge_time} s.", "when": "at 50% health"}])
