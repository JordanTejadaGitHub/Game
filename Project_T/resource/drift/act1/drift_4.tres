[gd_resource type="Resource" script_class="DriftData" load_steps=12 format=3]

[ext_resource type="Script" path="res://resource/drift/script/drift_data.gd" id="1_drift"]
[ext_resource type="Script" path="res://resource/drift/script/drift_group.gd" id="2_group"]
[ext_resource type="Script" path="res://resource/drift/script/drift_entry.gd" id="3_entry"]
[ext_resource type="Resource" path="res://resource/enemy/puffcap.tres" id="e_PC"]
[ext_resource type="Resource" path="res://resource/enemy/leaf_bug.tres" id="e_LB"]
[ext_resource type="Resource" path="res://resource/enemy/bark_beetle.tres" id="e_BB"]

[sub_resource type="Resource" id="Entry_1"]
script = ExtResource("3_entry")
