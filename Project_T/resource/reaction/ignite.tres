[gd_resource type="Resource" script_class="ReactionData" load_steps=2 format=3]

[ext_resource type="Script" path="res://resource/reaction/script/reaction_data.gd" id="1_rx"]

[resource]
script = ExtResource("1_rx")
id = &"ignite"
display_name = "Ignite"
statuses = Array[StringName]([&"spored", &"static"])
description = "Its {spored} burns for 3 s, hurting 4 times as fast, and each second a {stack} spreads to the nightmares beside it. Needs {stacks:need_spored} {spored} + {stacks:need_static} {static}. Uses up the {static}."
callout_color = Color(0.9137255, 0.65882355, 0.23529412, 1)
effect = &"ignite"
effect_scale = 1.75
