[gd_resource type="Resource" script_class="ReactionData" load_steps=2 format=3]

[ext_resource type="Script" path="res://resource/reaction/script/reaction_data.gd" id="1_rx"]

[resource]
script = ExtResource("1_rx")
id = &"starfall"
display_name = "Starfall"
statuses = Array[StringName]([&"marked", &"held", &"static"])
description = "Every nightmare within 3 cells with 8 or more {static} {stacks} sends its bolt into this one at once. Each bolt is a crit for ×2 damage and uses up that nightmare's {static}. Set off by a {combo:pinned} hit on a nightmare with 8 {static}."
callout_color = Color(0.9882353, 0.83137256, 0.4862745, 1)
effect = &"crowned_starfall"
effect_scale = 1.0
cooldown = 1.5
