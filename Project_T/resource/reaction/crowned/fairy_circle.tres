[gd_resource type="Resource" script_class="ReactionData" load_steps=2 format=3]

[ext_resource type="Script" path="res://resource/reaction/script/reaction_data.gd" id="1_rx"]

[resource]
script = ExtResource("1_rx")
id = &"fairy_circle"
display_name = "Fairy Circle"
statuses = Array[StringName]([&"spored", &"damp", &"held"])
description = "Mushroom rings sprout on the path cells around the nightmare for 6 s. The first nightmare on each ring gets 2 {spored} and {damp}. Triggered by a {combo:mushrooming} on a nightmare with {stacks:need_held} {held}. Bosses: the same. Not flyers."
callout_color = Color(0.9254902, 0.6117647, 0.95686275, 1)
effect = &"crowned_fairy_circle"
effect_scale = 1.0
cooldown = 1.5
