[gd_resource type="Resource" script_class="ReactionData" load_steps=2 format=3]

[ext_resource type="Script" path="res://resource/reaction/script/reaction_data.gd" id="1_rx"]

[resource]
script = ExtResource("1_rx")
id = &"nightbloom"
display_name = "Nightbloom"
statuses = Array[StringName]([&"spored", &"damp", &"drowsy"])
description = "The nightmare's spore cloud glows violet for 4 s: hits don't wake {asleep} nightmares inside, and they stay {asleep} while there. Bosses: they keep {full} {drowsy} instead. Triggered by a {combo:mushrooming} on a nightmare at {full} {drowsy}."
callout_color = Color(0.7372549, 0.26666668, 0.8627451, 1)
effect = &"crowned_nightbloom"
effect_scale = 1.0
cooldown = 1.5
