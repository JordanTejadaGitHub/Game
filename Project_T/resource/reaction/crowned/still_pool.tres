[gd_resource type="Resource" script_class="ReactionData" load_steps=2 format=3]

[ext_resource type="Script" path="res://resource/reaction/script/reaction_data.gd" id="1_rx"]

[resource]
script = ExtResource("1_rx")
id = &"still_pool"
display_name = "Still Pool"
statuses = Array[StringName]([&"damp", &"drowsy", &"held"])
description = "The nightmare sinks, and a still pool stays on its cell for 5 s. Each nightmare entering it for the first time falls {asleep} for 1 s. Triggered by a {combo:drown} on a nightmare with {stacks:need_held} {held}. Bosses: slowed 30% inside instead. Not flyers."
callout_color = Color(0.29803923, 0.54901963, 0.6431373, 1)
effect = &"crowned_still_pool"
effect_scale = 1.0
cooldown = 1.5
