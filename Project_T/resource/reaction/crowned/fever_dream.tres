[gd_resource type="Resource" script_class="ReactionData" load_steps=2 format=3]

[ext_resource type="Script" path="res://resource/reaction/script/reaction_data.gd" id="1_rx"]

[resource]
script = ExtResource("1_rx")
id = &"fever_dream"
display_name = "Fever Dream"
statuses = Array[StringName]([&"held", &"spored", &"drowsy"])
description = "It falls {asleep} for 2 s, and the nightmares beside it get 3 {spored} and 2 {drowsy}. Set off when {combo:smother} ends on a nightmare at {full} {drowsy}."
callout_color = Color(0.83137256, 0.9254902, 0.6117647, 1)
effect = &"crowned_fever_dream"
effect_scale = 1.0
cooldown = 1.5
