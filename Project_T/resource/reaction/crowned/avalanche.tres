[ext_resource type="Script" path="res://resource/reaction/script/reaction_data.gd" id="1_rx"]

[resource]
script = ExtResource("1_rx")
id = &"avalanche"
display_name = "Avalanche"
statuses = Array[StringName]([&"damp", &"held"])
description = "Scree covers the path under the stone for 4 s: nightmares on it are slowed 30% and gain 1 {held} every 0.5 s, up to 4 (bosses: slowed only). Set off by a {combo:shatter} from a lobbed stone ({warden:cairn}, {warden:rockslide})."
