[gd_resource type="Resource" script_class="ReactionData" load_steps=2 format=3]

[ext_resource type="Script" path="res://resource/reaction/script/reaction_data.gd" id="1_rx"]

[resource]
script = ExtResource("1_rx")
id = &"changeling"
display_name = "Changeling"
statuses = Array[StringName]([&"spored", &"drowsy", &"marked"])
description = "The nightmare trades places with the nightmare furthest ahead on its path within 3 {steps}, then turns around and walks toward the start. Not bosses or flyers. Triggered by a {combo:sleepwalk} on a nightmare with {stacks:need_marked} {marked}."
callout_color = Color(0.9254902, 0.6117647, 0.95686275, 1)
effect = &"crowned_nightbloom"
effect_scale = 1.0
cooldown = 1.5
