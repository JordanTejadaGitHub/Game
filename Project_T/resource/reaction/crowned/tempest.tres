[gd_resource type="Resource" script_class="ReactionData" load_steps=2 format=3]

[ext_resource type="Script" path="res://resource/reaction/script/reaction_data.gd" id="1_rx"]

[resource]
script = ExtResource("1_rx")
id = &"tempest"
display_name = "Tempest"
statuses = Array[StringName]([&"damp", &"static", &"spored"])
description = "The {combo:thunderclap}'s arcs trigger {combo:ignite} on nightmares with {stacks:need_spored} {spored}, and their burning spores spread {static}. Bosses: no {combo:ignite}. Triggered by a {combo:thunderclap} on a nightmare with {stacks:crown_spored} {spored}, or by an {combo:ignite} on one with {stacks:need_damp} {damp}. Each nightmare once every 2 s."
callout_color = Color(0.8627451, 0.8039216, 0.69803923, 1)
effect = &"crowned_tempest"
effect_scale = 1.0
cooldown = 1.5
