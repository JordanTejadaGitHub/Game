[gd_resource type="Resource" script_class="ReactionData" load_steps=2 format=3]

[ext_resource type="Script" path="res://resource/reaction/script/reaction_data.gd" id="1_rx"]

[resource]
script = ExtResource("1_rx")
id = &"tempest"
display_name = "Tempest"
statuses = Array[StringName]([&"damp", &"static", &"spored"])
description = "Each arc triggers {combo:ignite} on nightmares with {spored}, and Ignite's spreading spores also spread {static}, so more Thunderclaps follow. Needs 6 {spored} on a {combo:thunderclap}. Not again on the same nightmare for 2 s."
callout_color = Color(0.8627451, 0.8039216, 0.69803923, 1)
effect = &"crowned_tempest"
effect_scale = 1.0
cooldown = 1.5
