[gd_resource type="Resource" script_class="ReactionData" load_steps=2 format=3]

[ext_resource type="Script" path="res://resource/reaction/script/reaction_data.gd" id="1_rx"]

[resource]
script = ExtResource("1_rx")
id = &"pinned"
display_name = "Pinned"
statuses = Array[StringName]([&"marked", &"held"])
alternatives = Array[StringName]([&"drowsy"])
description = "The next hit on it is a guaranteed crit for ×3 damage that pierces: nightmares in a 3-cell line behind it take half. Triggered by {stacks:need_marked} {marked} + one of: {stacks:need_held} {held}, {full} {drowsy} or {asleep}. Uses up the {marked}, and the {drowsy} when the {drowsy} triggered it."
callout_color = Color(0.8627451, 0.9098039, 0.95686275, 1)
effect = &"pinned"
effect_scale = 1.75
