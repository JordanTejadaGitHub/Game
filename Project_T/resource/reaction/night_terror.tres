[gd_resource type="Resource" script_class="ReactionData" load_steps=2 format=3]

[ext_resource type="Script" path="res://resource/reaction/script/reaction_data.gd" id="1_rx"]

[resource]
script = ExtResource("1_rx")
id = &"night_terror"
display_name = "Night Terror"
statuses = Array[StringName]([&"static", &"drowsy"])
description = "It wakes screaming: its {static} fires at once as a bolt, and every nightmare within 2 cells can't move for 1 s (bosses 0.5 s) and gains 2 {held}. Needs {stacks:need_static} {static} + {full} {drowsy}. Uses up the {static} and the {drowsy}. Waits while it is {asleep} or near a {warden:dreamcatcher}."
callout_color = Color(0.6039216, 0.5176471, 0.9098039, 1)
effect = &"bolt_strike"
effect_scale = 1.5
