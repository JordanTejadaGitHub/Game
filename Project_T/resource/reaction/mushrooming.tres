[gd_resource type="Resource" script_class="ReactionData" load_steps=2 format=3]

[ext_resource type="Script" path="res://resource/reaction/script/reaction_data.gd" id="1_rx"]

[resource]
script = ExtResource("1_rx")
id = &"mushrooming"
display_name = "Mushrooming"
statuses = Array[StringName]([&"spored", &"damp"])
description = "A spore cloud covers its cell and the next path cell for 4 s: nightmares inside take 30% more effect damage (statuses, bolts and most {reactions}), until 1 s after they leave. Triggered by {stacks:need_spored} {spored} + {stacks:need_damp} {damp}. Uses up the {damp}."
callout_color = Color(0.9254902, 0.6117647, 0.95686275, 1)
effect = &"overgrowth"
effect_scale = 1.5
