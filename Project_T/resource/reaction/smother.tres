[gd_resource type="Resource" script_class="ReactionData" load_steps=2 format=3]

[ext_resource type="Script" path="res://resource/reaction/script/reaction_data.gd" id="1_rx"]

[resource]
script = ExtResource("1_rx")
id = &"smother"
display_name = "Smother"
statuses = Array[StringName]([&"held", &"spored"])
description = "While its {held} lasts, its {spored} stops dealing damage and builds up. When its {held} ends, all of it bursts at once for double. Triggered by {stacks:need_held} {held} + {stacks:need_spored} {spored}."
callout_color = Color(0.6117647, 0.76862746, 0.42352942, 1)
effect = &"smother"
effect_scale = 1.5
