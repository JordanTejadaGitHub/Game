[resource]
script = ExtResource("1_unlock")
id = "whirligig_ascension"
display_name = "Ascension: The Whirlwind"
description = "Unlocks {warden:tempest}, the strongest form of the {family:whirligig} {family}. A cyclone roams the path in its range, hitting everything it passes and carrying the statuses it touches on to the rest. In a run: from {drift} 51, unlock it for 3 {dreamlight}, then grow a {final_form} into it for 600 {dew}."
