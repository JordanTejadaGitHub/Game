[gd_resource type="Resource" script_class="UnlockData" format=3]

[ext_resource type="Script" path="res://resource/meta/script/unlock_data.gd" id="1_unlock"]

[resource]
script = ExtResource("1_unlock")
id = "dewdrop_ascension"
display_name = "Ascension: Tidecaller"
description = "Unlocks {warden:tidecaller}, the strongest form of the {family:dewdrop} {family}. Every 6 s a wave gives everything in range {damp} and drags it back 1 cell along the path; at 8 {damp} it is {frozen} for 1 s. In a run: from {drift} 51, unlock it for 3 {dreamlight}, then grow a {final_form} into it for 600 {dew}."
root = 0
costs = Array[int]([120])
order = 32
icon = 2
requires_all = Array[String](["dewdrop_hidden"])
dream_cards = Array[String](["dream_tidecaller"])
