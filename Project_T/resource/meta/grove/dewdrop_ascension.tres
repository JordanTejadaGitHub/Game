[ext_resource type="Script" path="res://resource/meta/script/unlock_data.gd" id="1_unlock"]

[resource]
script = ExtResource("1_unlock")
id = "dewdrop_ascension"
display_name = "Ascension: Tidecaller"
description = "{warden:tidecaller}: every 6 s a wave gives everything in range {damp}, pushes it back 1 {step}, and gives {field:tidecaller.frost_if_frosted:count} {frost} to those with {frost}. In a run, from {drift} 51: 3 {dreamlight} unlocks it, then 600 {dew} grows a {final_form} into it."
root = 0
costs = Array[int]([120])
order = 32
icon = 2
requires_all = Array[String](["dewdrop_hidden"])
dream_cards = Array[String](["dream_tidecaller"])
