[resource]
script = ExtResource("1_unlock")
id = "bellflower_ascension"
display_name = "Ascension: The Great Bell"
description = "Unlocks {warden:great_bell}, the {family:bellflower} {family}'s strongest form. In a run: from {drift} 51, unlock it for 3 {dreamlight}, then grow a {final_form} into it for 600 {dew}. Its toll puts every nightmare to sleep and triggers the {static} of each nightmare with 4 or more: its bolt strikes for half damage."
