script = ExtResource("1_unlock")
id = "rootling_ascension"
display_name = "Ascension: World Root"
description = "Unlocks {warden:world_root}, the strongest form of the {family:rootling} {family}. Every 5 s everything in range gains 1 {held}, and nightmares with {held} take 30% more damage from every Warden. In a run: from {drift} 51, unlock it for 3 {dreamlight}, then grow a {final_form} into it for 600 {dew}."
